# ---------------------------------------------------------------------------
# Gavora storefront — environment template
#
# Copy this file to client/.env. Vite inlines every VITE_* variable into the
# JavaScript bundle, so ONLY public values belong here. Never put a secret
# key, API secret or database credential in this file.
# ---------------------------------------------------------------------------

# API base URL. Leave blank to use the relative "/api" path, which the Vite dev
# proxy forwards to the server (and which works unchanged for a same-origin
# deployment). Set an absolute URL only when the API is on another origin.
VITE_API_URL=

# Where the dev server proxies /api requests. Must match the server's PORT.
VITE_API_PROXY_TARGET=http://localhost:5000

# Razorpay PUBLISHABLE key id (rzp_test_... / rzp_live_...). This is safe to
# expose. The matching key secret belongs in server/.env only.
VITE_RAZORPAY_KEY_ID=
