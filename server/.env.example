# ---------------------------------------------------------------------------
# Gavora API — environment template
#
# Copy this file to server/.env and fill in real values. Never commit .env.
# Every variable is validated at startup by src/config/env.js; the server
# refuses to boot with a missing or placeholder value.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- CORS ------------------------------------------------------------------
# Origin of the storefront. Add extra allowed origins as a comma-separated list.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Database --------------------------------------------------------------
# MongoDB Atlas: Database > Connect > Drivers, then append the database name.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gavora?retryWrites=true&w=majority
MONGO_URI=

# --- Authentication --------------------------------------------------------
# Two DIFFERENT random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# bcrypt cost factor (10-15). Higher is slower and more resistant to cracking.
BCRYPT_ROUNDS=12

# --- Payments (Razorpay) ---------------------------------------------------
# From the Razorpay dashboard: Settings > API Keys. Use test keys locally.
# KEY_SECRET and WEBHOOK_SECRET must never reach the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Store rules -----------------------------------------------------------
# Applied server-side when an order total is calculated.
SHIPPING_FLAT_RATE=79
FREE_SHIPPING_THRESHOLD=999
COD_ENABLED=true
COD_MAX_ORDER_VALUE=20000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
