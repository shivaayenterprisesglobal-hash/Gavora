// Gavora PostgreSQL schema (Prisma) — mapped from the current Mongoose models.
//
// ID strategy:
// Keep 24-character hex strings (Mongo ObjectId shape). The live API validates
// params with /^[a-fA-F0-9]{24}$/ and serializers expose `_id`. UUID/cuid would
// break those contracts. Prisma field name is `id`; API mapping to `_id` happens
// later. IDs are supplied by the app (or a pgcrypto default at migrate time).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum ProductStatus {
  draft
  active
  archived
}

enum CategoryStatus {
  active
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  online
  cod
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProvider {
  razorpay
  cod
}

enum AddressLabel {
  home
  work
  other
}

model User {
  id                 String    @id @db.VarChar(24)
  name               String    @db.VarChar(120)
  email              String    @unique @db.VarChar(254)
  phone              String?   @db.VarChar(10)
  passwordHash       String
  role               UserRole  @default(customer)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses          Address[]
  cart               Cart?
  orders             Order[]             @relation("CustomerOrders")
  statusChanges      OrderStatusEvent[]  @relation("StatusChangedBy")

  @@index([role])
  @@index([role, isActive])
  @@map("users")
}

/// Saved customer addresses. Mongoose embedded subdocuments with their own _id.
model Address {
  id        String       @id @db.VarChar(24)
  userId    String       @db.VarChar(24)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressLabel @default(home)
  fullName  String       @db.VarChar(120)
  phone     String       @db.VarChar(10)
  line1     String       @db.VarChar(200)
  line2     String       @default("") @db.VarChar(200)
  landmark  String       @default("") @db.VarChar(120)
  city      String       @db.VarChar(100)
  state     String       @db.VarChar(100)
  pincode   String       @db.VarChar(6)
  country   String       @default("India") @db.VarChar(100)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Category {
  id           String         @id @db.VarChar(24)
  name         String         @db.VarChar(120)
  slug         String         @unique @db.VarChar(120)
  description  String         @default("") @db.VarChar(1000)
  imageUrl     String         @default("")
  imageAlt     String         @default("") @db.VarChar(200)
  status       CategoryStatus @default(active)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  products     Product[]

  @@index([status])
  @@index([status, displayOrder, name])
  @@map("categories")
}

model Product {
  id                String        @id @db.VarChar(24)
  name              String        @db.VarChar(200)
  slug              String        @unique @db.VarChar(220)
  sku               String        @unique @db.VarChar(64)
  description       String        @default("") @db.VarChar(5000)
  shortDescription  String        @default("") @db.VarChar(300)
  categoryId        String        @db.VarChar(24)
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand             String        @default("") @db.VarChar(120)
  /// Whole rupees. Order maths stays server-side.
  price             Int
  salePrice         Int?
  stock             Int           @default(0)
  lowStockThreshold Int           @default(5)
  status            ProductStatus @default(draft)
  isFeatured        Boolean       @default(false)
  ratingAverage     Float         @default(0)
  ratingCount       Int           @default(0)
  unitsSold         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  images            ProductImage[]
  specifications    ProductSpecification[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([status, categoryId, price])
  @@index([status, unitsSold])
  @@index([status, slug])
  @@index([status, isFeatured, unitsSold])
  @@map("products")
}

/// Product gallery entry. Mongoose image subdocs have no _id.
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId String  @db.VarChar(24)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("") @db.VarChar(200)
  isPrimary Boolean @default(false)
  /// Preserves Mongo array order.
  position  Int     @default(0)

  @@index([productId, position])
  @@map("product_images")
}

model ProductSpecification {
  id        Int     @id @default(autoincrement())
  productId String  @db.VarChar(24)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  @db.VarChar(100)
  value     String  @db.VarChar(500)
  position  Int     @default(0)

  @@index([productId, position])
  @@map("product_specifications")
}

model Cart {
  id              String    @id @db.VarChar(24)
  userId          String    @unique @db.VarChar(24)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastCheckoutKey String?
  lastOrderId     String?   @db.VarChar(24)
  lastOrder       Order?    @relation("CartLastOrder", fields: [lastOrderId], references: [id], onDelete: SetNull)
  checkoutLock    Boolean   @default(false)
  checkoutLockAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           CartItem[]

  @@map("carts")
}

/// Cart line. Mongoose cart items have _id: false; identity is cart + product.
model CartItem {
  cartId        String  @db.VarChar(24)
  cart          Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String  @db.VarChar(24)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  priceSnapshot Int
  position      Int     @default(0)

  @@id([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id               String         @id @db.VarChar(24)
  orderNumber      String         @unique @db.VarChar(40)
  customerId       String         @db.VarChar(24)
  customer         User           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  contactEmail     String         @db.VarChar(254)
  subtotal         Int
  discount         Int            @default(0)
  shipping         Int            @default(0)
  total            Int
  currency         String         @default("INR") @db.VarChar(3)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus  @default(pending)
  paymentReference String?
  orderStatus      OrderStatus    @default(pending)
  customerNote     String         @default("") @db.VarChar(500)
  cancelledAt      DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            OrderItem[]
  address          OrderAddress?
  statusHistory    OrderStatusEvent[]
  payments         Payment[]
  cartsReferencing Cart[]         @relation("CartLastOrder")

  @@index([customerId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([orderStatus, createdAt])
  @@map("orders")
}

/// Checkout snapshot. Mongoose order items have _id: false.
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String  @db.VarChar(24)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.VarChar(24)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String  @db.VarChar(200)
  sku       String  @db.VarChar(64)
  image     String  @default("")
  unitPrice Int
  quantity  Int
  lineTotal Int
  position  Int     @default(0)

  @@index([orderId, position])
  @@index([productId])
  @@map("order_items")
}

/// Delivery snapshot on the order. Not a User Address FK; mongoose _id: false.
model OrderAddress {
  orderId  String @id @db.VarChar(24)
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fullName String @db.VarChar(120)
  phone    String @db.VarChar(20)
  line1    String @db.VarChar(200)
  line2    String @default("") @db.VarChar(200)
  landmark String @default("") @db.VarChar(120)
  city     String @db.VarChar(100)
  state    String @db.VarChar(100)
  pincode  String @db.VarChar(16)
  country  String @default("India") @db.VarChar(100)

  @@map("order_addresses")
}

model OrderStatusEvent {
  id          Int         @id @default(autoincrement())
  orderId     String      @db.VarChar(24)
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String      @default("") @db.VarChar(500)
  changedById String?     @db.VarChar(24)
  changedBy   User?       @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime    @default(now())
  position    Int         @default(0)

  @@index([orderId, position])
  @@map("order_status_events")
}

model Payment {
  id              String          @id @db.VarChar(24)
  orderId         String          @db.VarChar(24)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  paymentId       String?         @unique
  providerOrderId String?
  signature       String?
  amount          Int
  currency        String          @default("INR") @db.VarChar(3)
  status          PaymentStatus   @default(pending)
  failureReason   String?         @db.VarChar(500)
  refundId        String?
  refundedAmount  Int             @default(0)
  providerResponse Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model StoreSettings {
  id           String   @id @db.VarChar(24)
  storeName    String   @default("Gavora") @db.VarChar(80)
  logoUrl      String   @default("") @db.VarChar(2000)
  description  String   @default("") @db.VarChar(500)
  contactEmail String   @default("") @db.VarChar(254)
  contactPhone String   @default("") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("store_settings")
}
