{
  "name": "gavora",
  "version": "1.0.0",
  "private": true,
  "description": "Gavora — premium multi-category e-commerce platform",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names \"server,client\" --prefix-colors \"blue,magenta\" --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "preview": "npm run preview --workspace client",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "lint:fix": "npm run lint:fix --workspace server && npm run lint:fix --workspace client",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
